function clamp(v:number,a:number,b:number){return Math.max(a,Math.min(b,v))}
function positionName(id:number){return ['','GKP','DEF','MID','FWD'][id]||'UNK'}
export default async function(){try{const [bootR,fixR]=await Promise.all([fetch('https://fantasy.premierleague.com/api/bootstrap-static/',{headers:{'user-agent':'Mozilla/5.0'}}),fetch('https://fantasy.premierleague.com/api/fixtures/',{headers:{'user-agent':'Mozilla/5.0'}})]);if(!bootR.ok||!fixR.ok)return Response.json({error:'FPL upstream unavailable'},{status:502});const boot:any=await bootR.json(),fixtures:any[]=await fixR.json();const teams=new Map(boot.teams.map((t:any)=>[t.id,t]));const upcoming=fixtures.filter(f=>!f.finished&&f.event!=null).sort((a,b)=>a.event-b.event||new Date(a.kickoff_time).getTime()-new Date(b.kickoff_time).getTime());const finishedWeeks=boot.events.filter((e:any)=>e.finished).length||1;const players=boot.elements.map((p:any)=>{const team:any=teams.get(p.team);const next=upcoming.filter(f=>f.team_h===p.team||f.team_a===p.team).slice(0,5);const ppg=Number(p.points_per_game)||0,form=Number(p.form)||0,epNext=Number(p.ep_next)||0;const minutesShare=clamp((p.minutes||0)/(finishedWeeks*90),0,1);const fixturePreds=next.map((f:any)=>{const home=f.team_h===p.team,opp:any=teams.get(home?f.team_a:f.team_h),diff=home?f.team_h_difficulty:f.team_a_difficulty,difficultyFactor=clamp(1.18-(diff-1)*0.09,0.78,1.18),homeFactor=home?1.06:0.94,availability=p.status==='a'?1:p.status==='d'?0.72:0.35,base=.45*ppg+.35*form+.20*(epNext||ppg),mean=clamp(base*difficultyFactor*homeFactor*(.75+.25*minutesShare)*availability,0,16),sd=1.8+.48*mean,low=clamp(mean-1.28*sd,0,30),high=clamp(mean+1.28*sd,0,30);return{opponent:opp.short_name||opp.name,home,difficulty:diff,mean,low,high,event:f.event}});const pred5=fixturePreds.reduce((s:number,f:any)=>s+f.mean,0),variance=fixturePreds.reduce((s:number,f:any)=>s+Math.pow((f.high-f.low)/(2*1.28),2),0),sd5=Math.sqrt(variance);return{id:p.id,name:p.web_name,team:team.short_name||team.name,position:positionName(p.element_type),price:p.now_cost/10,selected:Number(p.selected_by_percent)||0,total:p.total_points||0,form,pointsPerGame:ppg,minutes:p.minutes||0,pred5,low5:clamp(pred5-1.28*sd5,0,100),high5:pred5+1.28*sd5,fixtures:fixturePreds}});return Response.json({players,meta:{updated:new Date().toISOString(),source:'Official FPL API',forecast:'baseline-v1'}})}catch(e:any){return Response.json({error:e?.message||'Unexpected error'},{status:500})}}
export const config={path:'/api/fpl'};
